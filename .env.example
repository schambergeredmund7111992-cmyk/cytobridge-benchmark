# Open-source/OpenAI-compatible LLM provider selection.
# Copy values into a private .env or export them in your shell. Do not commit real keys.
LLM_PROVIDER=kimi_parasail
KIMI_PARASAIL_API_KEY=replace_me
KIMI_SILICON_API_KEY=replace_me
KIMI_OFFICIAL_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
LOCAL_VLLM_URL=http://localhost:8000/v1
LOCAL_VLLM_API_KEY=EMPTY

# Optional PubMed contact email for NCBI E-utilities.
NCBI_EMAIL=you@example.com
